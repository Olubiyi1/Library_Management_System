generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

enum AccountType{
    STUDENT
    ADMIN
}

enum Section{
  TECH_1
  TECH_2
  TECH_3
}

enum Department{
  RAC
  ELECTRICAL
  PLUMBING
}

enum BorrowingStatus{
  BORROWED
  RETURN_PENDING
  RETURNED
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

enum FineReason {
  LATE_RETURN
  LOST_BOOK
  DAMAGED_BOOK
}

enum FineStatus {
  UNPAID
  PAID
  WAIVED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// enum PaymentProvider {
//   PAYSTACK
//   FLUTTERWAVE
//   STRIPE
// }

model User {
  id String @id @default(uuid())
  firstName String 
  lastName String
  email String @unique
  password String
  phoneNumber String
  isActive Boolean @default(true)
  accountType AccountType @default(STUDENT)
  section Section?
  department Department?
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reservations Reservation[]

  // relationships
  verificationToken VerificationToken[]
  refreshToken RefreshToken[]
  passwordResetToken PasswordResetToken[]
  borrowings Borrowing[]
  fines Fine[]

}

model VerificationToken{
  id String @id @default(uuid())
  token String @unique
  userId String 
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
} 

model PasswordResetToken{
  id String @id @default(uuid())
  token String @unique
  userId String 
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@index([userId])

}

model RefreshToken{
  id String @id @default(uuid())
  hashedToken String
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  @@index([userId])
}

model Author {
  id        String   @id @default(uuid())
  name      String
  isActive Boolean @default(true)
  books     Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id           String   @id @default(uuid())
  title        String
  authorId     String
  genre        String
  description  String
  totalCopies  Int
  availableCopies Int
  borrowings Borrowing[]
  reservations Reservation[]
  isActive Boolean @default(true)
  author       Author   @relation(fields: [authorId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([title, authorId])
}



model Borrowing{
  id String @id @default(uuid())
  userId String
  bookId String
  borrowedAt DateTime @default(now())
  dueDate DateTime
  status BorrowingStatus @default(BORROWED)
  returnedAt DateTime?


  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  book  Book @relation(fields: [bookId],references: [id],onDelete: Restrict)
  fine Fine?
}

model Reservation {
  id                String            @id @default(uuid())
  userId            String
  bookId            String
  reservedAt        DateTime          @default(now())
  dueDate           DateTime
  reservationStatus ReservationStatus @default(PENDING)

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  book              Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Fine {
  id          String    @id @default(uuid())
  borrowingId String @unique
  userId      String
  amount      Decimal
  reason      FineReason
  status      FineStatus @default(UNPAID)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  borrowing   Borrowing @relation(fields: [borrowingId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  payments    Payment[]
}


model Payment {
  id        String @id @default(uuid())
  fineId    String

  amount    Decimal
  reference String @unique
  status    PaymentStatus @default(PENDING)

  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fine      Fine @relation(fields: [fineId], references: [id])
}
