generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

enum AccountType{
    STUDENT
    ADMIN
}

enum Section{
  TECH_1
  TECH_2
  TECH_3
}

enum Department{
  RAC
  ELECTRICAL
  PLUMBING
}

enum BorrowingStatus{
  BORROWED
  RETURN_PENDING
  RETURNED
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

model User {
  id String @id @default(uuid())
  firstName String 
  lastName String
  email String @unique
  password String
  phoneNumber String
  isActive Boolean @default(true)
  accountType AccountType @default(STUDENT)
  section Section?
  department Department?
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reservations Reservation[]

  // relationships
  verificationToken VerificationToken[]
  refreshToken RefreshToken[]
  passwordResetToken PasswordResetToken[]
  borrowings Borrowing[]

}

model VerificationToken{
  id String @id @default(uuid())
  token String @unique
  userId String 
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
} 

model PasswordResetToken{
  id String @id @default(uuid())
  token String @unique
  userId String 
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@index([userId])

}

model RefreshToken{
  id String @id @default(uuid())
  hashedToken String
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  @@index([userId])
}

model Author {
  id        String   @id @default(uuid())
  name      String
  isActive Boolean @default(true)
  books     Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id           String   @id @default(uuid())
  title        String
  authorId     String
  genre        String
  description  String
  totalCopies  Int
  availableCopies Int
  borrowings Borrowing[]
  reservations Reservation[]
  isActive Boolean @default(true)
  author       Author   @relation(fields: [authorId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}



model Borrowing{
  id String @id @default(uuid())
  userId String
  bookId String
  borrowedAt DateTime @default(now())
  dueDate DateTime
  status BorrowingStatus @default(BORROWED)
  returnedAt DateTime?

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  book  Book @relation(fields: [bookId],references: [id],onDelete: Restrict)
}

model Reservation {
  id                String            @id @default(uuid())
  userId            String
  bookId            String
  reservedAt        DateTime          @default(now())
  dueDate           DateTime
  reservationStatus ReservationStatus @default(PENDING)

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  book              Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
}