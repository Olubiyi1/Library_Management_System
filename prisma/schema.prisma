generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

enum AccountType{
    STUDENT
    ADMIN
}

enum Section{
  TECH_1
  TECH_2
  TECH_3
}

enum Department{
  RAC
  ELECTRICAL
  PLUMBING
}

model User {
  id String @id @default(uuid())
  firstName String 
  lastName String
  email String @unique
  password String
  accountType AccountType @default(STUDENT)
  section Section?
  department Department?
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}